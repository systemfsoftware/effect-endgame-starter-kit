{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "XDG_CACHE_HOME",
    "SANDBOX",
    "HTTPS_PROXY",
    "HTTP_PROXY",
    "NO_PROXY",
    "https_proxy",
    "http_proxy",
    "no_proxy",
    "NODE_USE_ENV_PROXY"
  ],
  "tasks": {
    "generate": {
      "outputLogs": "errors-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ],
      "outputs": [
        "src/routeTree.gen.ts"
      ],
      "cache": true
    },
    "build": {
      "outputLogs": "new-only",
      "inputs": [
        "src/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json",
        "tsdown.config.*"
      ],
      "outputs": [
        "dist/**"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "outputLogs": "errors-only",
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json",
        "!**/*.md"
      ],
      "outputs": [],
      "dependsOn": [
        "^build",
        "generate"
      ],
      "cache": true
    },
    "//#typecheck:node": {
      "outputLogs": "errors-only",
      "inputs": [
        "tsconfig.node.json",
        "commitlint.config.ts",
        ".lintstagedrc.js",
        "oxlint.shared.ts",
        "stryker.shared.ts"
      ],
      "outputs": [],
      "cache": true
    },
    "//#test:scripts": {
      "outputLogs": "errors-only",
      "inputs": [
        "scripts/**",
        "flake.nix",
        "flake.lock"
      ],
      "outputs": [],
      "cache": true
    },
    "//#lint:suppressions": {
      "outputLogs": "errors-only",
      "cache": false
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.ts",
        "vitest.config.*",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "!**/README.md",
        "!**/AGENTS.md",
        "!**/CHANGELOG.md"
      ],
      "outputLogs": "new-only",
      "dependsOn": [
        "^build",
        "build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "env": [
        "NODE_ENV",
        "CI",
        "AGENT"
      ],
      "cache": true
    },
    "mutation": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "stryker.config.ts",
        "vitest.config.ts",
        "$TURBO_ROOT$/stryker.shared.ts",
        "vitest.setup.ts",
        "reports/stryker-incremental.json",
        "!**/*.md"
      ],
      "outputs": [
        "reports/mutation-report.html",
        "reports/mutation-report.json"
      ],
      "env": [
        "NODE_ENV",
        "CI",
        "AGENT"
      ],
      "passThroughEnv": [
        "GITHUB_ACTIONS"
      ],
      "cache": true
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "oxlint.config.ts",
        "$TURBO_ROOT$/oxlint.shared.ts",
        "tsconfig.json",
        "tsconfig.*.json",
        "!**/*.md"
      ],
      "outputs": [],
      "dependsOn": [
        "^build",
        "build",
        "generate"
      ],
      "env": [
        "NODE_ENV",
        "GITHUB_ACTIONS",
        "OXLINT_FORMAT",
        "AGENT"
      ],
      "cache": true
    },
    "attw": {
      "outputLogs": "errors-only",
      "inputs": [
        "dist/**",
        "package.json"
      ],
      "dependsOn": [
        "build"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
