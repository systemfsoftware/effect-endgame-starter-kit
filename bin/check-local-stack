#!/usr/bin/env bash
# One-command stack acceptance: `pnpm dev` must run with no terminal, and the
# stack must start without reaching the internet.
#
# It starts the stack the way an agent or a CI job does — stdout is not a TTY
# and TERM is unset — inside an unprivileged network namespace, waits for every
# readiness probe, asserts Grafana never reaches for a plugin, stops the stack
# and checks every port is free. local-stack/data is scratch: the check clears
# it so the plugin assertion reads a fresh run, and clears it again when the
# stack stops cleanly. `pnpm check:ci` runs it as `check:ci-run`.
#
# Needs Linux, curl, iproute2 (`ip`) and either `unshare -rn` or bwrap.
set -uo pipefail

readonly self="$(readlink -f "${BASH_SOURCE[0]}")"
readonly root="$(dirname "$(dirname "$self")")"
cd "$root" || exit 1

readonly data=local-stack/data
readonly up_log="$data/up.log"
readonly compose_log="$data/process-compose.log"
# Every port the stack binds: Grafana, Tempo (http, grpc, otlp), the collector
# (otlp grpc, otlp http, health) and process-compose's own API.
readonly ports=(3000 3200 4317 4318 4417 8080 9095 13133)
readonly probes=(http://127.0.0.1:13133/ http://127.0.0.1:3200/ready http://127.0.0.1:3000/api/health)
readonly plugin_install='Installing plugin|plugin\.installer|Downloaded and extracted'
readonly ready_budget=180
readonly free_budget=30

fail() { printf 'check-local-stack: %s\n' "$*" >&2; exit 1; }
note() { printf 'check-local-stack: %s\n' "$*"; }

listening() { # true when something accepts a connection on a stack port
  local port
  for port in "${ports[@]}"; do
    if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
      exec 3>&- || true
      return 0
    fi
  done
  return 1
}

stack_logs() {
  printf '%s\n' '--- last 25 lines of the stack client log ---'
  tail -n 25 "$up_log" 2>/dev/null || true
  printf '%s\n' '--- last 25 lines of the process-compose log ---'
  tail -n 25 "$compose_log" 2>/dev/null || true
}

assert_no_plugin_install() {
  local matches
  matches=$(grep -RhoE "($plugin_install)" --include='*.log' "$data" 2>/dev/null | sort -u || true)
  if [ -n "$matches" ]; then
    stack_logs
    printf 'check-local-stack: Grafana reached for a plugin with the network denied:\n%s\n' "$matches" >&2
    exit 1
  fi
}

stop_started_stack() {
  if [ -n "${stack_pid:-}" ]; then
    kill "$stack_pid" 2>/dev/null || true
    wait "$stack_pid" 2>/dev/null || true
    stack_pid=
  fi
}

run_under_denied_network() {
  ip link set lo up || fail 'could not raise the namespace loopback'
  if curl -m 5 -sS -o /dev/null https://grafana.com; then
    fail 'the namespace still reaches the internet; a plugin download could hide'
  fi
  note 'network denied; starting the stack headless'
  rm -rf "$data"
  mkdir -p "$data"
  timeout 300 env -u TERM ./bin/local-stack up >"$up_log" 2>&1 </dev/null &
  stack_pid=$!
  # Never leave a half-started stack behind when an assertion below fails.
  trap stop_started_stack EXIT
  local deadline=$((SECONDS + ready_budget))
  until timeout 20 ./bin/local-stack project is-ready >/dev/null 2>&1; do
    if ! kill -0 "$stack_pid" 2>/dev/null; then
      stack_logs
      fail '`pnpm dev` exited before the stack was ready'
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
      stack_logs
      fail 'the stack did not become ready'
    fi
    sleep 2
  done
  local probe
  for probe in "${probes[@]}"; do
    if ! curl -fsS -m 5 -o /dev/null "$probe"; then
      stack_logs
      fail "readiness probe $probe failed after the project reported ready"
    fi
  done
  assert_no_plugin_install
  note 'every readiness probe answered and Grafana stayed offline'
  timeout 150 ./bin/local-stack down || {
    stack_logs
    fail 'the stack did not stop cleanly'
  }
  stop_started_stack
  local free_deadline=$((SECONDS + free_budget))
  while listening; do
    if [ "$SECONDS" -ge "$free_deadline" ]; then
      fail 'a stack port is still open after shutdown'
    fi
    sleep 1
  done
  note 'the stack stopped and every port is free'
  rm -rf "$data"
}

main() {
  [ "$(uname)" = Linux ] || fail 'Linux only (a network namespace denies the internet)'
  command -v curl >/dev/null 2>&1 || fail 'curl is required'
  command -v ip >/dev/null 2>&1 || fail 'iproute2 (ip) is required to raise the namespace loopback'
  if listening; then
    fail 'a stack port is already open; stop the running stack first'
  fi
  if ! command -v local-stack >/dev/null 2>&1; then
    command -v nix >/dev/null 2>&1 || fail 'no local-stack on PATH and no nix to build it from flake.nix'
    note 'realising .#local-stack'
    local stack
    stack=$(nice -n 10 nix build --no-link --print-out-paths .#local-stack) || fail 'nix build .#local-stack failed'
    PATH="$stack/bin:$PATH"
    export PATH
  fi
  local netns
  if unshare -rn true 2>/dev/null; then
    netns=(unshare -rn)
  elif bwrap --unshare-net --dev-bind / / --uid 0 --gid 0 true 2>/dev/null; then
    netns=(bwrap --unshare-net --dev-bind / / --uid 0 --gid 0)
  else
    fail 'no unprivileged network namespace (unshare -rn or bwrap --unshare-net)'
  fi
  note "running the stack under ${netns[0]} with no terminal"
  "${netns[@]}" bash "$self" --inside-network-namespace
}

if [ "${1:-}" = --inside-network-namespace ]; then
  run_under_denied_network
else
  main
fi
