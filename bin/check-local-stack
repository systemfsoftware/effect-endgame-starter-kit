#!/usr/bin/env bash
# One-command stack acceptance: the stack must start headless — the way an
# agent or a CI job runs it, stdout not a TTY and TERM unset — with the
# launcher's network denial in force, so a Grafana plugin download cannot hide.
#
# It re-enters through the sandbox, whose unshared network and cleared
# environment are the denial, proves the internet is unreachable, waits for
# every readiness probe, asserts Grafana never reached for a plugin, runs one
# job in the heavy-job service (its image under podman, no network, one socket
# to the Worker), stops the stack and checks every port is free.
# local-stack/data is scratch: the check clears it so the plugin assertion reads
# a fresh run, and clears it again when the stack stops cleanly. `pnpm check:ci`
# runs it as `check:ci-run`.
#
# Needs Linux, curl, jq and the sandbox launcher (the dev shell provides them).
set -uo pipefail

readonly self="$(readlink -f "${BASH_SOURCE[0]}")"
readonly root="$(dirname "$(dirname "$self")")"
cd "$root" || exit 1

readonly data=local-stack/data
readonly up_log="$data/up.log"
readonly compose_log="$data/process-compose.log"
# Every port the stack binds: the site, Grafana, Tempo (http, grpc, otlp), the
# collector (otlp grpc, otlp http, health, metrics) and process-compose's API.
readonly ports=(1337 3000 3200 4317 4318 4417 8080 8888 9095 13133)
readonly probes=(http://127.0.0.1:1337/llms.txt http://127.0.0.1:13133/ http://127.0.0.1:3200/ready http://127.0.0.1:3000/api/health)
# Declared so the launcher's macOS profile permits each bind; nothing is
# published, because the probes run against the sandbox's own loopback.
readonly listens=(--listen 1337 --listen 3000 --listen 3200 --listen 4317 --listen 4318 --listen 4417 --listen 8080 --listen 8888 --listen 9095 --listen 13133)
readonly plugin_install='Installing plugin|plugin\.installer|Downloaded and extracted'
readonly ready_budget=180
readonly free_budget=30
readonly heavy_job_budget=120

fail() { printf 'check-local-stack: %s\n' "$*" >&2; exit 1; }
note() { printf 'check-local-stack: %s\n' "$*"; }

listening() { # true when something accepts a connection on a stack port
  local port
  for port in "${ports[@]}"; do
    if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
      exec 3>&- || true
      return 0
    fi
  done
  return 1
}

stack_logs() {
  printf '%s\n' '--- last 25 lines of the stack client log ---'
  tail -n 25 "$up_log" 2>/dev/null || true
  printf '%s\n' '--- last 25 lines of the process-compose log ---'
  tail -n 25 "$compose_log" 2>/dev/null || true
}

assert_no_plugin_install() {
  local matches
  matches=$(grep -RhoE "($plugin_install)" --include='*.log' "$data" 2>/dev/null | sort -u || true)
  if [ -n "$matches" ]; then
    stack_logs
    printf 'check-local-stack: Grafana reached for a plugin with the network denied:\n%s\n' "$matches" >&2
    exit 1
  fi
}

heavy_job_state() { # status and exit code of the heavy-job process, e.g. "Completed 0"
  timeout 20 ./bin/local-stack process get heavy-job --output json 2>/dev/null |
    jq -r '(if type == "array" then .[0] else . end) | "\(.status) \(.exit_code)"'
}

run_heavy_job() {
  local digest state
  digest=$(heavy-job --digest) || fail 'the heavy-job runner is not on PATH'
  timeout 20 ./bin/local-stack process start heavy-job >/dev/null || {
    stack_logs
    fail 'process-compose did not start the heavy-job service'
  }
  local deadline=$((SECONDS + heavy_job_budget))
  until state=$(heavy_job_state) && [ "${state%% *}" = Completed ]; do
    if [ "$SECONDS" -ge "$deadline" ]; then
      stack_logs
      fail "the heavy-job service did not finish its job (last state: ${state:-unknown})"
    fi
    sleep 1
  done
  if [ "${state##* }" != 0 ]; then
    stack_logs
    fail "the heavy-job service's job exited ${state##* }"
  fi
  note "the heavy-job service ran image $digest with no network; its job reached the Worker through its one socket"
}

release_stack() {
  if [ -n "${stack_pid:-}" ]; then
    kill "$stack_pid" 2>/dev/null || true
    wait "$stack_pid" 2>/dev/null || true
    stack_pid=
  fi
}

run_inside_launcher() {
  if curl -m 5 -sS -o /dev/null https://grafana.com; then
    fail 'the launcher left the internet reachable; a plugin download could hide'
  fi
  note 'the launcher denies the network; starting the stack headless'
  rm -rf "$data"
  mkdir -p "$data"
  timeout 300 env -u TERM ./bin/local-stack up >"$up_log" 2>&1 </dev/null &
  stack_pid=$!
  # Never leave a half-started stack behind when an assertion below fails.
  trap release_stack EXIT
  local deadline=$((SECONDS + ready_budget))
  until timeout 20 ./bin/local-stack project is-ready >/dev/null 2>&1; do
    if ! kill -0 "$stack_pid" 2>/dev/null; then
      stack_logs
      fail '`pnpm dev` exited before the stack was ready'
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
      stack_logs
      fail 'the stack did not become ready'
    fi
    sleep 2
  done
  local probe
  for probe in "${probes[@]}"; do
    if ! curl -fsS -m 5 -o /dev/null "$probe"; then
      stack_logs
      fail "readiness probe $probe failed after the project reported ready"
    fi
  done
  assert_no_plugin_install
  note 'every readiness probe answered and Grafana stayed offline'
  run_heavy_job
  timeout 150 ./bin/local-stack down || {
    stack_logs
    fail 'the stack did not stop cleanly'
  }
  release_stack
  local free_deadline=$((SECONDS + free_budget))
  while listening; do
    if [ "$SECONDS" -ge "$free_deadline" ]; then
      fail 'a stack port is still open after shutdown'
    fi
    sleep 1
  done
  note 'the stack stopped and every port is free'
  rm -rf "$data"
}

main() {
  [ "$(uname)" = Linux ] || fail 'Linux only (a network namespace denies the internet)'
  command -v curl >/dev/null 2>&1 || fail 'curl is required'
  if listening; then
    fail 'a stack port is already open; stop the running stack first'
  fi
  # The stack runs pnpm and the Worker; outside the dev shell neither is in the
  # launcher's readable closure, so enter it first.
  if ! command -v sandbox >/dev/null 2>&1; then
    command -v nix >/dev/null 2>&1 || fail 'no sandbox on PATH and no nix to enter the dev shell'
    note 'entering the dev shell for the sandbox'
    exec nix develop --command bash "$self"
  fi
  exec sandbox "${listens[@]}" -- bash "$self"
}

if [ "${SANDBOX:-}" = 1 ]; then
  run_inside_launcher
else
  main
fi
