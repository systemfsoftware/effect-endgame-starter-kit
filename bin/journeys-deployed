#!/usr/bin/env bash
# Run the e2e journeys against a deployed copy of the site. The journeys only
# read the site, so their sandbox gets no Cloudflare credentials and may reach
# one host: SITE_URL's.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

url="${SITE_URL:?set SITE_URL to the deployed site, e.g. https://<worker>.<subdomain>.workers.dev}"
host="${url#*://}"

exec sandbox \
  --allow-host "${host%%/*}" \
  --pass-env SITE_URL \
  --pass-env PLAYWRIGHT_BROWSERS_PATH \
  -- pnpm --filter @endgame/site-e2e journeys
