#!/usr/bin/env bash
# Run a Cloudflare-facing command (an alchemy deploy or destroy, a deploy
# check, a rollback) inside the sandbox. This is the one place the Cloudflare
# credentials enter a sandbox, and the one list of hosts such a command may
# reach: Cloudflare's API, and the account's workers.dev hosts, where
# alchemy's state store answers. Telemetry stays off, so nothing else needs
# to be reachable.
set -euo pipefail

export DO_NOT_TRACK=1
exec sandbox \
  --allow-host api.cloudflare.com \
  --allow-host '*.workers.dev' \
  --pass-env CLOUDFLARE_API_TOKEN \
  --pass-env CLOUDFLARE_ACCOUNT_ID \
  --pass-env ALCHEMY_CLOUDFLARE_API_LOG \
  --pass-env DO_NOT_TRACK \
  --pass-env CI \
  -- "$@"
