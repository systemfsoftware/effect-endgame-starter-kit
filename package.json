{
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@effect/tsgo": "0.44.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@systemfsoftware/all": "1.1.3",
    "@systemfsoftware/tsconfig": "1.3.3",
    "@types/node": "^24",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "license": "Apache-2.0",
  "name": "pnpm-release-management",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/pnpm-release-management.git"
  },
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "scripts": {
    "build": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} build",
    "check:ci": "s=0; pnpm format:check || s=1; TURBO_CONCURRENCY=${TURBO_CONCURRENCY:-100%} pnpm gate:tasks || s=1; pnpm gate:dist || s=1; exit $s",
    "clean": "turbo clean",
    "format": "./bin/dprint fmt",
    "format:check": "./bin/dprint check",
    "gate:dist": "turbo --concurrency=${TURBO_CONCURRENCY:-100%} build",
    "gate:tasks": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} --continue lint typecheck typecheck:node test",
    "lint": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} lint",
    "precommit": "pnpm exec lint-staged --no-revert --config .lintstagedrc.js",
    "prepare": "husky",
    "test": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} test",
    "typecheck": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} --continue typecheck typecheck:node",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit"
  },
  "type": "module"
}
