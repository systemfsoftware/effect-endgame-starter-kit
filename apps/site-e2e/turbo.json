{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "generate": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    },
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/oxlint.shared.ts"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/oxlint.shared.ts"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    },
    "mutation": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/tsconfig.base.json"
      ]
    }
  }
}
