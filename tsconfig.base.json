{
  // The one repo-wide unstable-API opt-in, exactly `effect/http` (Kiro ruling, 2026-10-05) and
  // `effect/http-api` (2026-10-06: the spec's HTTP API is Effect HttpApi + OpenAPI, shipped only there).
  // Effect 4.0.1 ships HTTP only under the unstable marker; effecttsgo/unstable-api-usage
  // (new in @effect/tsgo 0.48.1) errors on it, and global-fetch-in-effect bans the fetch
  // alternative. Drop this when @systemfsoftware/tsconfig carries the same opt-in.
  "extends": "@systemfsoftware/tsconfig/bundler/dom",
  "compilerOptions": {
    "plugins": [{ "name": "@effect/language-service", "allowedUnstableApis": ["effect/http", "effect/http-api"] }]
  }
}
