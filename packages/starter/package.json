{
  "author": "TODO <todo@example.com>",
  "description": "TODO: one-line description",
  "devDependencies": {
    "@systemfsoftware/effect-gherkin-spec": "catalog:",
    "@systemfsoftware/oxlint-config-recommended": "catalog:",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "catalog:",
    "@systemfsoftware/stryker-js": "catalog:",
    "@systemfsoftware/stryker-js-typescript-checker": "catalog:",
    "@systemfsoftware/stryker-js-vitest-runner": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "name": "@TODO/starter",
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "private": true,
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsdown",
    "clean": "rimraf dist",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "mutation": "stryker run",
    "mutation:full": "stryker run --force",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit --incremental && tsc -p tsconfig.node.json --noEmit"
  },
  "type": "module",
  "version": "0.0.0",
  "stryker": {
    "mutate": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/**/*.d.ts"
    ]
  }
}
