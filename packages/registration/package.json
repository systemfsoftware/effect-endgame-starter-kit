{
  "description": "Workshop registration: seats held, waitlisted or refused by a per-person cap, decided as pure workflows",
  "dependencies": {
    "@systemfsoftware/effect-cell-types": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@systemfsoftware/effect-schema-law": "catalog:",
    "@systemfsoftware/effect-schema-vite": "catalog:",
    "@systemfsoftware/oxlint-config-recommended": "catalog:",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "catalog:",
    "@systemfsoftware/stryker-js": "catalog:",
    "@systemfsoftware/stryker-js-typescript-checker": "catalog:",
    "@systemfsoftware/stryker-js-vitest-runner": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@systemfsoftware/vitest": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "default": "./src/mod.ts"
    }
  },
  "license": "Apache-2.0",
  "name": "@endgame/registration",
  "private": true,
  "scripts": {
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "mutation": "stryker run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --incremental && effect-tsgo diagnostics --project tsconfig.json --format text --strict && tsc -p tsconfig.node.json --noEmit"
  },
  "type": "module",
  "version": "0.0.0",
  "stryker": {
    "mutate": [
      "src/**/*.workflow.ts",
      "!src/**/*.test.ts"
    ]
  }
}
