(version 1)
(deny default)

(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow pseudo-tty)
(allow ipc-posix-sem)
(allow sysctl-read)
(allow iokit-open (iokit-registry-entry-class "RootDomainUserClient"))
(allow system-mac-syscall (mac-policy-name "vnguard"))
(allow system-fsctl (fsctl-command FSIOC_CAS_BSDFLAGS))

(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership")
  (global-name "com.apple.system.DirectoryService.libinfo_v1")
  (global-name "com.apple.bsd.dirhelper")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.logd")
  (global-name "com.apple.diagnosticd")
  (global-name "com.apple.trustd")
  (global-name "com.apple.trustd.agent")
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.SystemConfiguration.DNSConfiguration")
  (global-name "com.apple.SystemConfiguration.configd")
  (global-name "com.apple.PowerManagement.control"))

(allow file-read-metadata (path-ancestors (param "PROJECT")))
(allow file-read-metadata (path-ancestors (param "HOME")))
(allow file-read-metadata (subpath "/var") (subpath "/private/var") (literal "/etc") (literal "/tmp"))
(allow file-read* (literal "/"))

(allow file-read*
  (subpath "/nix/store")
  (subpath "/System")
  (subpath "/Library/Apple")
  (subpath "/Library/Preferences")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/usr/bin")
  (subpath "/usr/sbin")
  (subpath "/usr/libexec")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/private/etc")
  (subpath "/private/var/db/timezone")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/dev/autofs_nowait")
  (subpath "/dev/fd"))
(allow file-map-executable (subpath "/nix/store") (subpath "/System") (subpath "/usr/lib"))

(allow file-read* file-write* file-ioctl
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/tty")
  (literal "/dev/ptmx")
  (regex #"^/dev/ttys[0-9]+$")
  (regex #"^/dev/fd/[0-9]+$"))

(allow file-read* file-write*
  (subpath (param "PROJECT"))
  (subpath (param "HOME"))
  (subpath (param "TMP")))

(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
(allow network-outbound (literal "/private/var/run/syslog"))
